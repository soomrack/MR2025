void cleanupOnWinsockError() {
    WSACleanup();
    system("pause");
}

void cleanupOnSocketError() {
    WSACleanup();
    system("pause");
}

void cleanupOnConnectionError(SOCKET client_fd) {
    closesocket(client_fd);
    WSACleanup();
    system("pause");
}

SOCKET initializeClientSocket(const string& server_ip) {
    SOCKET client_fd = INVALID_SOCKET;

    if (!initializeWinsock()) {
        cleanupOnWinsockError();
        return INVALID_SOCKET;
    }

    client_fd = createClientSocket();
    if (client_fd == INVALID_SOCKET) {
        cleanupOnWinsockError();
        return INVALID_SOCKET;
    }

    if (!connectToServer(client_fd, server_ip, 8080)) {
        cleanupOnConnectionError(client_fd);
        return INVALID_SOCKET;
    }

    return client_fd;
}

int main() {
    setupConsoleEncoding();
    showWelcomeMessage();

    string server_ip = getServerIpAddress();

    SOCKET client_fd = initializeClientSocket(server_ip);
    if (client_fd == INVALID_SOCKET) {
        return 1;
    }

    displayChatStartedMessage();

    thread receive_thread(receiveMessages, client_fd);
    receive_thread.detach();

    sendMessages(client_fd);

    cleanupResources(client_fd);
    system("pause");
    return 0;
}
