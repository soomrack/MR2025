bool initializeWinsock() {
    WSADATA wsaData;
    if (WSAStartup(MAKEWORD(2, 2), &wsaData) != 0) {
        cout << "[ERROR] WSAStartup failed" << endl;
        return false;
    }
    return true;
}

SOCKET createClientSocket() {
    SOCKET client_fd = socket(AF_INET, SOCK_STREAM, 0);
    if (client_fd == INVALID_SOCKET) {
        cout << "[ERROR] Socket creation failed: " << WSAGetLastError() << endl;
        return INVALID_SOCKET;
    }
    return client_fd;
}

bool connectToServer(SOCKET client_fd, const string& server_ip, int port) {
    sockaddr_in server_addr = {};
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(port);

    if (inet_pton(AF_INET, server_ip.c_str(), &server_addr.sin_addr) <= 0) {
        cout << "[ERROR] Invalid server address" << endl;
        return false;
    }

    if (connect(client_fd, (sockaddr*)&server_addr, sizeof(server_addr)) == SOCKET_ERROR) {
        cout << "[ERROR] Connection failed: " << WSAGetLastError() << endl;
        return false;
    }

    cout << "[INFO] Connected to server at " << server_ip << ":" << port << endl;
    return true;
}

