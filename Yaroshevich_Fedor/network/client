string processCommand(const string& command) {
    if (command == "/hello10") return commandHello10();
    if (command == "/shtirlits") return commandShtirlits();
    if (command == "/command") return commandList();
    if (command == "/fortune") return commandFortune();
    if (command == "/motivation") return commandMotivation();
    if (command == "/time") return commandTime();
    return "";
}

bool isCommand(const string& input) {
    return !input.empty() && input[0] == '/';
}

void receiveMessages(SOCKET client_fd) {
    char buffer[1024] = {};

    while (true) {
        int bytes_received = recv(client_fd, buffer, sizeof(buffer) - 1, 0);

        if (bytes_received > 0) {
            buffer[bytes_received] = '\0';
            cout << "\n" << buffer << "> ";
            cout.flush();
        }
        else if (bytes_received == 0) {
            cout << "\n[INFO] Server disconnected" << endl;
            break;
        }
        else {
            cout << "\n[ERROR] Receive failed" << endl;
            break;
        }
    }
}

void handleCommand(const string& message) {
    string command_result = processCommand(message);
    if (!command_result.empty()) {
        cout << "\n" << command_result << "> ";
    }
    else {
        cout << "[WARNING] Unknown command: " << message << endl;
    }
}

void sendMessage(SOCKET client_fd, const string& message) {
    if (send(client_fd, message.c_str(), static_cast<int>(message.length()), 0) == SOCKET_ERROR) {
        cout << "[ERROR] Send failed: " << WSAGetLastError() << endl;
    }
}

void sendMessages(SOCKET client_fd) {
    string message;

    while (true) {
        cout << "> ";
        getline(cin, message);

        if (message.empty()) {
            continue;
        }

        if (isCommand(message)) {
            string result = processCommand(message);
            if (!result.empty()) {
                cout << "\n" << result << "> ";
                sendMessage(client_fd, result);
            }
            else {
                cout << "[WARNING] Unknown command: " << message << endl;
            }
            continue;
        }

        sendMessage(client_fd, message);
    }
}

void cleanupResources(SOCKET client_fd) {
    closesocket(client_fd);
    WSACleanup();
    cout << "[INFO] Client shutdown complete" << endl;
}

